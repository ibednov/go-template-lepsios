# --- app ---
PORT=8080
HTTP_HOST_PORT=8080
ENVIRONMENT=development
SERVICE_NAME=go-template-lepsios
CORS_ALLOWED_ORIGINS=*

# --- server ---
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s

# --- log ---
LOG_LEVEL=info
LOG_VECTOR_URL=
LOG_UI_PORT=9428
LOG_VECTOR_PORT=8687

# --- db ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=template
DB_PASSWORD=template
DB_NAME=template
DB_SSL_MODE=disable
DB_OPTIONAL=false
DB_CONTAINER_NAME=go-template-lepsios-postgres

# --- redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_OPTIONAL=false
REDIS_CONTAINER_NAME=go-template-lepsios-redis

# --- files (go-lepsios files.Adapter, always on) ---
FILES_DRIVER=local
FILES_LOCAL_DIR=var/files
FILES_S3_ENDPOINT=localhost:9000
FILES_S3_ACCESS_KEY=minioadmin
FILES_S3_SECRET_KEY=minioadmin
FILES_S3_BUCKET=template
FILES_S3_REGION=us-east-1
FILES_S3_USE_SSL=false
FILES_S3_PUBLIC_URL=

# --- migration ---
MIGRATION_RUN=true
MIGRATION_BACKUP=true
MIGRATION_BACKUP_PREFIX=backups/pre-migrate

# --- local compose ---
APP_CONTAINER_NAME=go-template-lepsios-api-local
